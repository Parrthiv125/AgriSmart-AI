# ============================================================
# AgriSmart AI Frontend — Environment Configuration Template
# Copy to frontend/.env or frontend/.env.local to customize.
# ============================================================

# Backend API Base URL (defaults to http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Set to true only if developing frontend completely offline without the FastAPI backend
VITE_USE_MOCK_API=false
