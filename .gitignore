# ============================================================
# AgriSmart AI — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.eggs/

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter
.ipynb_checkpoints
*.ipynb
# Allow the Colab training notebook specifically
!AgriSmart_AI_Training_Colab.ipynb

# PyTorch / Model files
*.pth
*.pt
*.ckpt
*.pkl
*.h5
*.hdf5

# Dataset (do NOT commit raw data)
data/raw/
data/processed/
data/processed_model2/
data/plantvillage/
data/plantdoc/
data/model2_manifest.json
data/model2_split_stats.json
*.zip
*.tar.gz
*.tar

# Allow notebooks specifically
!notebooks/AgriSmart_Model2_Field_Adaptation.ipynb
!notebooks/AgriSmart_Model2_AutoTrain_v2.ipynb

# Large files / model weights
# (use GitHub Releases or cloud storage for model weights > 100 MB)
models/*.pth
models/*.pt
!models/agrismart_best.pth
!models/agrismart_field_adapted_best.pth

# Logs and experiment tracking / scratch
*.log
experiments/
models/agrismart_field_adapted_last.pth
!experiments_model2.csv
!models/agrismart_field_adapted_metadata.json
mlruns/
wandb/
runs/
scratch/

# OS & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Environment / secrets
.env
*.env
config/secrets.yaml
config/secrets.json
*_secret*
*_key*

