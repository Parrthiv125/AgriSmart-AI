# ============================================================
# AgriSmart AI — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.eggs/

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter
.ipynb_checkpoints
*.ipynb
# Allow the Colab training notebook specifically
!AgriSmart_AI_Training_Colab.ipynb

# PyTorch / Model files
*.pth
*.pt
*.ckpt
*.pkl
*.h5
*.hdf5

# Dataset (do NOT commit raw data)
data/raw/
data/processed/
data/plantvillage/
*.zip
*.tar.gz
*.tar

# Evaluation outputs (generated — keep results/ tracked via git if small)
evaluation/results/*.png
evaluation/results/*.jpg

# Logs and experiment tracking
*.log
experiments/
mlruns/
wandb/
runs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Environment / secrets
.env
*.env
config/secrets.yaml
config/secrets.json
*_secret*
*_key*

# Frontend build artifacts
frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/build/
frontend/.cache/

# Temporary files
tmp/
temp/
*.tmp
*.swp
*.swo

# Large files / model weights
# (use GitHub Releases or cloud storage for model weights > 100 MB)
models/*.pth
models/*.pt
!models/agrismart_best.pth

