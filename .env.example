# ============================================================
# AgriSmart AI — Environment Configuration Template
# Copy to .env if you need to override default settings.
# ============================================================

# Backend FastAPI Settings
PORT=8000
HOST=127.0.0.1

# Allowed CORS Origins (comma-separated list)
# Default allows localhost:5173, localhost:3000, localhost:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Model Paths (optional overrides; defaults to models/agrismart_field_adapted_best.pth)
# MODEL_PATH=models/agrismart_field_adapted_best.pth
# CLASSES_PATH=models/classes.json
